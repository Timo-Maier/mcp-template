{
  "name": "mcp-server-template",
  "version": "1.0.0",
  "description": "MCP server template for SAP BTP — wraps OData APIs with XSUAA auth and principal propagation",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "build": "sh scripts/build-srv.sh",
    "bind-services": "sh scripts/bind-services.sh",
    "test": "vitest run",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/xsenv": "^6.2.1",
    "@sap/xssec": "^4.13.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "passport": "^0.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "prettier": "^3.9.5",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
